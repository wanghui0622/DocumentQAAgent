OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek 示例（仅 LLM，embedding 会自动降级为 BM25）:
# OPENAI_API_BASE=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat

# 阿里云 DashScope 示例（北京地域，当前项目推荐）:
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxx
# LLM_MODEL=qwen3.7-plus
# EMBEDDING_MODEL=text-embedding-v4

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_FINAL_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# Verifier
VERIFIER_MIN_GROUNDING=0.7

# OCR
OCR_DPI=300
PDF_TEXT_THRESHOLD=50
# 强制所有 PDF 走 PaddleOCR（作业两个文档建议 parse --all --force-ocr）
PDF_FORCE_OCR=false
# 乱码/全角文本层检测阈值（超过则自动走 OCR，GBT 国标扫描件会自动命中）
PDF_BAD_TEXT_PAGE_THRESHOLD=0.15
PDF_BAD_TEXT_AVG_THRESHOLD=0.10

# Paths
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
CHROMA_DIR=data/processed/chroma
